#!/usr/bin/env python3
"""bench-fleet — compare two OpenAI-compatible endpoints on the same prompt.

Measures time-to-first-token (TTFT) and generation tok/s for each endpoint via
streaming chat completions, averaged over --runs iterations. Designed to compare
the in-tree colibri engine (glm.c) against a NeutronStar ds4-server, but works
for any two /v1/chat/completions servers.

Examples:
  bench-fleet --a-url http://localhost:8000/v1 --a-model glm-5.2-chat \
              --b-url http://localhost:8100/v1 --b-model glm-5.2-chat \
              --prompt "Explain ROCm in one paragraph." --runs 3

  glm neutronstar bench   # uses colibri [primary] as A and ds4-server:8000 as B
"""
import sys, os, json, time, argparse, urllib.request, urllib.error


def stream_chat(url, key, model, prompt, max_tokens, timeout=600):
    """Return (ttft_s, gen_tokens, gen_tok_s, ok, err). Uses SSE streaming."""
    body = json.dumps({
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": max_tokens,
        "temperature": 0,
        "stream": True,
    }).encode()
    req = urllib.request.Request(url.rstrip("/") + "/chat/completions", data=body,
                                 headers={"Content-Type": "application/json"})
    if key:
        req.add_header("Authorization", f"Bearer {key}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            t0 = time.monotonic()
            ttft = None
            n_tokens = 0
            usage_tokens = None
            for raw in r:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                payload = line[5:].strip()
                if payload == "[DONE]":
                    break
                try:
                    obj = json.loads(payload)
                except Exception:
                    continue
                if obj.get("usage") and obj["usage"].get("completion_tokens"):
                    usage_tokens = obj["usage"]["completion_tokens"]
                choice = (obj.get("choices") or [{}])[0]
                delta = (choice.get("delta") or {}).get("content") or ""
                if delta:
                    if ttft is None:
                        ttft = time.monotonic() - t0
                    n_tokens += 1
            t1 = time.monotonic()
            gen_time = (t1 - ttft) if ttft else (t1 - t0)
            if usage_tokens:
                n_tokens = usage_tokens
            gen_tok_s = (n_tokens / gen_time) if gen_time > 0 else 0.0
            return ttft or 0.0, n_tokens, gen_tok_s, True, None
    except Exception as e:
        return 0.0, 0, 0.0, False, f"{type(e).__name__}: {e}"


def run_endpoint(label, url, key, model, prompt, max_tokens, runs):
    ttfts, toks, spds = [], [], []
    err = None
    for i in range(runs):
        ttft, n, spd, ok, e = stream_chat(url, key, model, prompt, max_tokens)
        if not ok:
            err = e
            break
        ttfts.append(ttft); toks.append(n); spds.append(spd)
        print(f"  [{label}] run {i+1}/{runs}: ttft={ttft*1000:.0f}ms "
              f"tokens={n} {spd:.1f} tok/s", file=sys.stderr)
    if err:
        return None, err
    avg = lambda xs: sum(xs) / len(xs) if xs else 0.0
    return {
        "ttft_ms": avg(ttfts) * 1000,
        "tokens": avg(toks),
        "tok_s": avg(spds),
    }, None


def main():
    ap = argparse.ArgumentParser(description="compare two OpenAI endpoints")
    ap.add_argument("--a-url", required=True)
    ap.add_argument("--a-model", default="model")
    ap.add_argument("--a-key", default="")
    ap.add_argument("--b-url", required=True)
    ap.add_argument("--b-model", default="model")
    ap.add_argument("--b-key", default="")
    ap.add_argument("--prompt", default="Explain the difference between a GPU and an APU in one paragraph.")
    ap.add_argument("--max-tokens", type=int, default=200)
    ap.add_argument("--runs", type=int, default=3)
    args = ap.parse_args()

    print(f"prompt: {args.prompt[:80]}...")
    print(f"runs={args.runs} max_tokens={args.max_tokens}\n")

    a, ea = run_endpoint("A (colibri)", args.a_url, args.a_key, args.a_model,
                         args.prompt, args.max_tokens, args.runs)
    b, eb = run_endpoint("B (neutronstar)", args.b_url, args.b_key, args.b_model,
                         args.prompt, args.max_tokens, args.runs)

    print("\n=== results (mean over runs) ===")
    print(f"{'endpoint':16} {'TTFT(ms)':>10} {'tokens':>8} {'tok/s':>10}")
    if a:
        print(f"{'A (colibri)':16} {a['ttft_ms']:>10.0f} {a['tokens']:>8.0f} {a['tok_s']:>10.1f}")
    else:
        print(f"{'A (colibri)':16}  ERROR: {ea}")
    if b:
        print(f"{'B (neutronstar)':16} {b['ttft_ms']:>10.0f} {b['tokens']:>8.0f} {b['tok_s']:>10.1f}")
    else:
        print(f"{'B (neutronstar)':16}  ERROR: {eb}")
    if a and b:
        speedup = a['tok_s'] / b['tok_s'] if b['tok_s'] else 0
        print(f"\nB vs A tok/s ratio: {speedup:.2f}x  (1.00 = identical)")


if __name__ == "__main__":
    main()
