def serve_local(role, sec, cfg):
    """Launch a local serve role via scripts/colibri-serve, overriding the
    profile with this role's section when present."""
    script = os.path.join(HERE, "scripts", "colibri-serve")
    merged = dict(cfg.get("primary", {}))
    cache = dict(cfg.get("cache", {}))
    for k, v in sec.items():
        merged[k] = v
    import tempfile
    tmp = tempfile.NamedTemporaryFile("w", suffix=".toml", delete=False, dir=HERE)
    tmp.write('[primary]\n')
    for k, v in merged.items():
        if isinstance(v, bool):
            tmp.write(f'{k} = {"true" if v else "false"}\n')
        elif isinstance(v, str):
            tmp.write(f'{k} = "{v}"\n')
        else:
            tmp.write(f'{k} = {v}\n')
    tmp.write('[cache]\n')
    for k, v in cache.items():
        if isinstance(v, bool):
            tmp.write(f'{k} = {"true" if v else "false"}\n')
        elif isinstance(v, str):
            tmp.write(f'{k} = "{v}"\n')
        else:
            tmp.write(f'{k} = {v}\n')
    tmp.close()
    eprint(f"glm {role}: serving local model (pid parent)")
    os.execv(script, [script, tmp.name])


def proxy_chat(sec, prompt):
    bu = sec.get("base_url")
    if not bu:
        sys.exit("this role has no base_url (it is a local-serve role)")
    model = sec.get("model_id", "model")
    key = sec.get("api_key", "")
    url = bu.rstrip("/") + "/chat/completions"
    body = json.dumps({"model": model, "messages": [{"role": "user", "content": prompt}],
                       "temperature": 0, "max_tokens": 512}).encode()
    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
    if key:
        req.add_header("Authorization", f"Bearer {key}")
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            data = json.load(r)
            print(data["choices"][0]["message"]["content"])
    except urllib.error.HTTPError as e:
        sys.exit(f"chat failed: {e.code} {e.read().decode()[:500]}")


def chat_completion(base_url, api_key, model, messages, timeout=120):
    """Minimal OpenAI chat completion; returns the assistant text (no streaming)."""
    url = base_url.rstrip("/") + "/chat/completions"
    body = json.dumps({"model": model, "messages": messages, "temperature": 0,
                       "max_tokens": 1024}).encode()
    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
    if api_key:
        req.add_header("Authorization", f"Bearer {api_key}")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)["choices"][0]["message"]["content"]


def resolve_role(cfg, role):
    if role == "opencode":
        if "primary" not in cfg:
            sys.exit("no [primary] section in config")
        return "opencode", cfg["primary"], True
    if role == "hermes":
        sec = cfg.get("hermes") or cfg.get("helper")
        if not sec:
            sys.exit("no [helper] / [hermes] section in config")
        return "hermes", sec, "model" in sec
    if role.startswith("tiny-"):
        name = role[len("tiny-"):]
        sec = cfg.get("tiny", {}).get(name)
        if not sec:
            sys.exit(f"no [tiny.{name}] section in config (tiny harness not built yet)")
        return role, sec, "model" in sec
    sys.exit(f"unknown role: {role}  (try: opencode, hermes, tiny-<name>)")


def estimate_tokens(body):
    """Rough token estimate to drive routing (no tokenizer dependency)."""
    msgs = body.get("messages", [])
    text = " ".join(m.get("content", "") for m in msgs if isinstance(m, dict))
    n = max(1, len(text) // 4)
    n += int(body.get("max_tokens", 0) or 0)
    return n


def pick_backend(cfg, body):
    proxy = cfg.get("proxy", {})
    thr = int(proxy.get("route_max_tokens", 256))
    est = estimate_tokens(body)
    helper = cfg.get("helper") or cfg.get("hermes")
    primary = cfg.get("primary", {})
    if helper and helper.get("base_url") and est <= thr:
        return ("helper", helper["base_url"], helper.get("api_key", ""),
                helper.get("model_id", "model"))
    pbase = f"http://{primary.get('host','127.0.0.1')}:{primary.get('port',8000)}/v1"
    return ("glm", pbase, primary.get("api_key", ""), primary.get("model_id", "model"))


def run_proxy(cfg):
    proxy = cfg.get("proxy", {})
    host = proxy.get("host", "127.0.0.1")
    port = int(proxy.get("port", 8200))
    rewrite = proxy.get("rewrite_model_id", True)
    thr = int(proxy.get("route_max_tokens", 256))
    # Hardening: reject oversized request bodies, and trip a circuit breaker
    # (return 503) after repeated upstream failures so a dead backend can't
    # hang every request for 600s.
    max_body = int(proxy.get("max_body_bytes", 8 * 1024 * 1024))
    br_fail = int(proxy.get("breaker_failures", 5))
    br_cooldown = int(proxy.get("breaker_cooldown_s", 30))
    max_conn = int(proxy.get("max_connections", 64))
    require_auth = bool(proxy.get("require_auth", False))
    proxy_key = proxy.get("api_key", "")
    import time as _time
    import threading as _threading
    breaker = {}  # target_url -> {"fails": int, "open_until": float}
    _inflight = [0]
    _inflight_lock = _threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        def _read_body(self):
            length = int(self.headers.get("Content-Length", 0) or 0)
            if length > max_body:
                return {"__too_large__": length}
            raw = self.rfile.read(min(length, max_body)) if length else b"{}"
            try:
                return json.loads(raw)
            except Exception:
                return {}

        def _forward(self, target_url, target_key, target_model, body):
            if rewrite and target_model:
                body["model"] = target_model
            now = _time.monotonic()
            st = breaker.get(target_url)
            if st and st["open_until"] > now:
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"error": {"message": "circuit open for upstream",
                                                         "type": "circuit_open",
                                                         "retry_after_s": int(st["open_until"] - now)}}).encode())
                return
            fwd = json.dumps(body).encode()
            req = urllib.request.Request(target_url, data=fwd,
                                         headers={"Content-Type": "application/json"})
            if target_key:
                req.add_header("Authorization", f"Bearer {target_key}")
            try:
                r = urllib.request.urlopen(req, timeout=600)
            except urllib.error.HTTPError as e:
                self.send_response(e.code)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(e.read())
                return
            except (urllib.error.URLError, ConnectionError, OSError) as e:
                b = breaker.setdefault(target_url, {"fails": 0, "open_until": 0.0})
                b["fails"] += 1
                if b["fails"] >= br_fail:
                    b["open_until"] = now + br_cooldown
                    eprint(f"[proxy] circuit OPEN for {target_url} ({b['fails']} failures)")
                self.send_response(502)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"error": {"message": f"upstream unreachable: {e}",
                                                         "type": "upstream_unreachable"}}).encode())
                return
            if target_url in breaker:
                breaker[target_url] = {"fails": 0, "open_until": 0.0}
            self.send_response(r.status if hasattr(r, "status") else 200)
            ct = r.headers.get("Content-Type", "application/json")
            self.send_header("Content-Type", ct)
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            try:
                while True:
                    chunk = r.read(1 << 16)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    self.wfile.flush()
            except (BrokenPipeError, OSError) as e:
                eprint(f"[proxy] client disconnected mid-stream: {e}")

        def do_GET(self):
            if self.path.rstrip("/") in ("/health", "/v1/health"):
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "ok", "role": "proxy",
                                             "routes": {"glm": "primary", "helper": "helper"},
                                             "route_max_tokens": thr}).encode())
                return
            self.send_response(404); self.end_headers()

        def do_POST(self):
            if self.path.rstrip("/") in ("/v1/chat/completions", "/chat/completions"):
                # optional auth on the proxy port itself
                if require_auth and proxy_key:
                    auth = self.headers.get("Authorization", "")
                    if auth != f"Bearer {proxy_key}" and auth.split(" ", 1)[-1] != proxy_key:
                        self.send_response(401)
                        self.send_header("Content-Type", "application/json")
                        self.end_headers()
                        self.wfile.write(json.dumps({"error": {"message": "unauthorized",
                                                               "type": "unauthorized"}}).encode())
                        return
                # concurrency guard: shed load instead of exhausting threads
                with _inflight_lock:
                    if _inflight[0] >= max_conn:
                        self.send_response(429)
                        self.send_header("Content-Type", "application/json")
                        self.send_header("Retry-After", "1")
                        self.end_headers()
                        self.wfile.write(json.dumps({"error": {"message": "too many concurrent requests",
                                                               "type": "busy"}}).encode())
                        return
                    _inflight[0] += 1
                try:
                    body = self._read_body()
                    if "__too_large__" in body:
                        self.send_response(413)
                        self.send_header("Content-Type", "application/json")
                        self.end_headers()
                        self.wfile.write(json.dumps({"error": {"message": f"request too large ({body['__too_large__']} bytes)",
                                                                 "type": "payload_too_large"}}).encode())
                        return
                    label, bu, key, mid = pick_backend(cfg, body)
                    eprint(f"[proxy] -> {label} ({bu})")
                    self._forward(bu.rstrip("/") + "/chat/completions", key, mid, body)
                finally:
                    with _inflight_lock:
                        _inflight[0] = max(0, _inflight[0] - 1)
                return
            self.send_response(404); self.end_headers()

        def log_message(self, *a):
            pass

    eprint(f"glm proxy: http://{host}:{port}/v1  (route <= {thr} tok -> helper, else GLM)")
    eprint(f"glm proxy: max_body={max_body}B  breaker={br_fail} fails/{br_cooldown}s")
    HTTPServer((host, port), Handler).serve_forever()


def cmd_route(cfg, prompt):
    body = {"messages": [{"role": "user", "content": prompt}], "max_tokens": 0}
    label, bu, key, mid = pick_backend(cfg, body)
    est = estimate_tokens(body)
    eprint(f"estimate={est} tok  ->  {label}  ({bu})  model={mid}")


def hermes_config(cfg, extra=None):
    """Emit (or --apply) the Hermes cli-config.yaml [model] block so Hermes
    routes through the helper endpoint (OpenAI-compatible via provider:\"custom\").

    By default prints to stdout with the api_key REDACTED. Use --show-key to
    reveal it, --apply to write the file (with a .bak backup), --out=PATH to
    choose the destination (default ~/.hermes/cli-config.yaml).
    """
    extra = extra or []
    h = cfg.get("hermes", {})
    bu = h.get("adapter_base_url") or (cfg.get("helper", {}) or {}).get("base_url")
    key = h.get("adapter_api_key") or (cfg.get("helper", {}) or {}).get("api_key", "")
    model = h.get("helper") or (cfg.get("helper", {}) or {}).get("model_id", "model")
    if not bu:
        sys.exit("no hermes.adapter_base_url / helper.base_url in config")
    block = (
        "# generated by: glm hermes config  (drop into cli-config.yaml or ~/.hermes/cli-config.yaml)\n"
        "model:\n"
        f"  default: \"{model}\"\n"
        "  provider: \"custom\"\n"
        f"  base_url: \"{bu}\"\n"
        f"  api_key: \"{key}\"\n"
    )
    show_key = "--show-key" in extra
    if not show_key:
        block = block.replace(f'api_key: "{key}"', 'api_key: "<redacted; pass --show-key>"')
    if "--apply" in extra:
        out = os.path.expanduser("~/.hermes/cli-config.yaml")
        for a in extra:
            if a.startswith("--out="):
                out = os.path.expanduser(a.split("=", 1)[1])
        bak = out + ".bak"
        if os.path.exists(out):
            import shutil
            shutil.copy2(out, bak)
        os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
        with open(out, "w") as f:
            f.write(block)
        eprint(f"wrote {out} (backup: {bak})")
    print(block)


def hermes_check(cfg, extra=None):
    """Verify the hermes-adapter helper endpoint: /health up AND the configured
    model_id is actually advertised by its /v1/models (when available)."""
    extra = extra or []
    h = cfg.get("hermes", {}) or cfg.get("helper", {})
    bu = h.get("adapter_base_url") or h.get("base_url")
    key = h.get("adapter_api_key") or h.get("api_key", "")
    model = h.get("helper") or h.get("model_id", "model")
    if not bu:
        sys.exit("no hermes/helper base_url in config")
    hurl = bu.rstrip("/") + "/health"
    req = urllib.request.Request(hurl)
    if key:
        req.add_header("Authorization", f"Bearer {key}")
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            data = json.load(r)
            eprint(f"hermes-adapter OK: {hurl}\n{json.dumps(data, indent=2)}")
    except Exception as e:
        eprint(f"hermes-adapter: {bu}  ({type(e).__name__}: {e})")
        return
    # model_id advertised?
    murl = bu.rstrip("/") + "/v1/models"
    req = urllib.request.Request(murl)
    if key:
        req.add_header("Authorization", f"Bearer {key}")
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            mdata = json.load(r)
        ids = [m.get("id") for m in mdata.get("data", [])]
        if model in ids:
            eprint(f"[PASS] model_id '{model}' advertised by {murl}")
        elif ids:
            eprint(f"[WARN] model_id '{model}' NOT in {murl} (got: {ids[:8]})")
        else:
            eprint(f"[WARN] {murl} returned no model list")
    except Exception as e:
        eprint(f"[WARN] {murl} unavailable ({type(e).__name__}); cannot verify model_id")


def run_harness(cfg, task):
    """Tier-3 orchestrator: a small LM plans subtasks, each is fanned out to a
    subagent (tiny.<name>) endpoint in parallel, results are collected and the
    orchestrator synthesizes a final answer.

    Hardened: plan is schema-validated (unknown/empty subtasks dropped), each
    subtask runs with a timeout + bounded retries, results are truncated before
    synthesis, and the fan-out respects a per-subtask timeout so one slow
    subagent can't hang the whole task.
    """
    h = cfg.get("harness", {})
    if not h.get("enabled", True):
        sys.exit("harness disabled in config ([harness].enabled=false)")
    obu = h.get("base_url"); okey = h.get("api_key", ""); omodel = h.get("model_id", "model")
    subs = h.get("subagents", [])
    if not subs:
        sys.exit("[harness] no subagents configured ([harness].subagents)")
    max_sub = int(h.get("max_subtasks", 8))
    orch_timeout = int(h.get("orchestrator_timeout_s", 180))
    subtask_timeout = int(h.get("subtask_timeout_s", 120))
    max_result = int(h.get("max_result_chars", 4000))
    retries = int(h.get("subtask_retries", 1))
    if not task or task == "-":
        task = sys.stdin.read().strip()
    if not task:
        sys.exit("usage: glm harness \"<task>\"  (or pipe task via stdin)")

    eprint(f"[harness] task: {task[:80]}...")
    # 1) orchestrator plans subtasks as a JSON list of {"subagent":<name>,"task":<text>}
    plan_prompt = [
        {"role": "system", "content": "You are an orchestrator. Decompose the user task into "
         "independent subtasks. Reply ONLY with a JSON array: "
         "[{\"subagent\": <name>, \"task\": <text>}, ...]. Valid subagent names: "
         + ", ".join(subs) + ". If the task is atomic, return a single-element array."},
        {"role": "user", "content": task},
    ]
    try:
        plan_text = chat_completion(obu, okey, omodel, plan_prompt, timeout=orch_timeout)
    except Exception as e:
        sys.exit(f"[harness] orchestrator unreachable: {e}")
    # 2) parse + validate the plan (drop unknown/empty subtasks)
    import re
    from concurrent.futures import as_completed
    m = re.search(r"\[.*\]", plan_text, re.DOTALL)
    try:
        raw = json.loads(m.group(0)) if m else []
    except Exception:
        raw = []
    if not isinstance(raw, list):
        raw = [{"subagent": subs[0], "task": task}]
    plan = []
    for it in raw:
        if not isinstance(it, dict):
            eprint(f"[harness] drop non-object subtask: {it!r}")
            continue
        nm = it.get("subagent")
        if nm not in subs:
            eprint(f"[harness] drop subtask for unknown subagent '{nm}' (valid: {subs})")
            continue
        if not isinstance(it.get("task"), str) or not it["task"].strip():
            eprint(f"[harness] drop subtask with empty task for '{nm}'")
            continue
        plan.append(it)
    plan = plan[:max_sub]
    if not plan:
        sys.exit("[harness] orchestrator returned no valid subtasks; aborting")
    eprint(f"[harness] plan: {len(plan)} valid subtask(s)")

    # 3) fan out each subtask to its subagent (tiny.<name>) endpoint in parallel
    def run_sub(sub):
        name = sub["subagent"]; stext = sub["task"]
        sec = cfg.get("tiny", {}).get(name)
        if not sec or not sec.get("base_url"):
            return name, f"[no [tiny.{name}] endpoint configured]"
        last = None
        for attempt in range(1, retries + 1):
            try:
                last = chat_completion(sec["base_url"], sec.get("api_key", ""),
                                       sec.get("model_id", name),
                                       [{"role": "user", "content": stext}],
                                       timeout=subtask_timeout)
                if len(last) > max_result:
                    last = last[:max_result] + f"\n...[truncated {len(last) - max_result} chars]"
                return name, last
            except Exception as e:
                last = e
                eprint(f"[harness] {name} attempt {attempt}/{retries} failed: {e}")
        return name, f"[subagent {name} error after {retries} attempts: {last}]"

    results = []
    with ThreadPoolExecutor(max_workers=max_sub) as ex:
        futs = {ex.submit(run_sub, sub): sub for sub in plan}
        for fut in as_completed(futs):
            nm = futs[fut]["subagent"]
            try:
                results.append(fut.result(timeout=subtask_timeout))
            except Exception as e:
                results.append((nm, f"[subagent {nm} timeout: {e}]"))
    # keep original plan order for the synthesis context
    order = {s["subagent"]: i for i, s in enumerate(plan)}
    results.sort(key=lambda r: order.get(r[0], 1 << 30))

    # 4) orchestrator synthesizes the final answer from the subtask results
    synth_msgs = [{"role": "system", "content": "Synthesize a final answer from the subtask "
                  "results below."},
                  {"role": "user", "content": "\n\n".join(f"[{n}]\n{r}" for n, r in results)}]
    try:
        final = chat_completion(obu, okey, omodel, synth_msgs, timeout=orch_timeout)
    except Exception as e:
        final = "\n\n".join(f"[{n}]\n{r}" for n, r in results)  # fallback: raw concat
    print(final)


def cmd_neutronstar(cfg, args):
    """NeutronStar (ds4) lifecycle wrapper: build / serve / status / bench.

    Defaults to the HX 370 (gfx1150, 96 GB) machine; pass 'halo' for Strix Halo.
    The NeutronStar repo lives at $NEUTRONSTAR_DIR (default ~/git/neutronstar).
    `serve`/`build` are live actions (compile / bind a port) and require COLI_LIVE.
    """
    ns_dir = os.environ.get("NEUTRONSTAR_DIR", os.path.expanduser("~/git/neutronstar"))
    if not os.path.isdir(ns_dir):
        sys.exit(f"NeutronStar repo not found: {ns_dir} (set $NEUTRONSTAR_DIR)")
    sub = args[1] if len(args) > 1 else None

    if sub in (None, "help", "-h"):
        eprint("glm neutronstar <subcommand>")
        eprint("  build [hx370|halo]                 build ds4 / ds4-server (live)")
        eprint("  serve <model.gguf> [port] [hx370|halo]   launch ds4-server (live)")
        eprint("  status [port]                      check ds4-server /health + /v1/models")
        eprint("  bench [extra bench-fleet args]      compare colibri primary vs ds4-server tok/s")
        return

    if sub == "build":
        machine = args[2] if len(args) > 2 else "hx370"
        require_armed("glm neutronstar build")
        if machine == "hx370":
            script = os.path.join(ns_dir, "build-hx370.sh")
            os.execv(script, [script])
        os.execv("/usr/bin/make", ["make", "-C", ns_dir, "strix-halo"])
        return

    if sub == "serve":
        if len(args) < 3:
            sys.exit("usage: glm neutronstar serve <model.gguf> [port] [hx370|halo]")
        model = args[2]; port = args[3] if len(args) > 3 else "8000"
        machine = args[4] if len(args) > 4 else "hx370"
        require_armed("glm neutronstar serve")
        script = os.path.join(ns_dir, "scripts", "serve.sh")
        if not os.path.exists(script):
            sys.exit(f"serve script missing: {script}")
        os.execv(script, [script, machine, model, port])
        return

    if sub == "status":
        port = args[2] if len(args) > 2 else "8000"
        base = f"http://127.0.0.1:{port}"
        up, data = _endpoint_up(base + "/health")
        if not up:
            eprint(f"ds4-server: DOWN at {base} (start with: glm neutronstar serve <model.gguf>)")
            return
        eprint(f"ds4-server: OK {base}/health")
        upm, mdata = _endpoint_up(base + "/v1/models")
        if upm and mdata:
            ids = [m.get("id") for m in mdata.get("data", [])]
            eprint(f"  models: {ids}")
        return

    if sub == "bench":
        script = os.path.join(HERE, "scripts", "bench-fleet")
        if not os.path.exists(script):
            sys.exit(f"bench-fleet missing: {script}")
        prim = cfg.get("primary", {})
        a_url = f"http://{prim.get('host','127.0.0.1')}:{int(prim.get('port',8000))}/v1"
        a_model = prim.get("model_id", "model")
        b_url = "http://127.0.0.1:8100/v1"
        os.execv(script, [script, "--a-url", a_url, "--a-model", a_model,
                           "--b-url", b_url, "--b-model", "glm-5.2-chat"] + args[2:])
        return

    sys.exit(f"unknown neutronstar subcommand: {sub}")


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        eprint(__doc__)
        return
    cmd = args[0]
    if cmd in ("ls", "list"):
        cfg, _ = load_cfg(); cmd_ls(cfg); return
    if cmd == "doctor":
        cfg, _ = load_cfg(); cmd_doctor(cfg); return
    if cmd == "arm":
        eprint("To arm the fleet for LIVE actions (serve/proxy/harness/train), run in your shell:")
        eprint("    export COLI_LIVE=1")
        eprint("It is DISARMED by default; glm will refuse live actions until set.")
        return
    if cmd == "disarm":
        eprint("To disarm the fleet, run in your shell:")
        eprint("    unset COLI_LIVE")
        return
    if cmd == "health":
        cfg, _ = load_cfg(); cmd_health_all(cfg); return
    if cmd == "route":
        cfg, _ = load_cfg()
        if len(args) < 2:
            sys.exit("usage: glm route \"your prompt\"")
        cmd_route(cfg, " ".join(args[1:])); return
    if cmd == "proxy":
        cfg, _ = load_cfg()
        if not cfg.get("proxy", {}).get("enabled", True):
            sys.exit("proxy disabled in config ([proxy].enabled=false)")
        require_armed("glm proxy")
        run_proxy(cfg); return
    if cmd == "hermes":
        cfg, _ = load_cfg()
        sub = args[1] if len(args) > 1 else None
        if sub == "config":
            hermes_config(cfg, args[2:]); return
        if sub == "check":
            hermes_check(cfg, args[2:]); return
        # default: status; or chat
        if sub == "chat":
            if len(args) < 3:
                sys.exit("usage: glm hermes chat \"your prompt\"")
            require_armed("glm hermes chat")
            _, sec, _ = resolve_role(cfg, "hermes")
            proxy_chat(sec, " ".join(args[2:])); return
        _, sec, is_local = resolve_role(cfg, "hermes")
        if is_local:
            sys.exit("hermes role is remote; use 'glm hermes config|check|chat'")
        bu = sec.get("base_url"); key = sec.get("api_key", "")
        url = bu.rstrip("/") + "/health"
        req = urllib.request.Request(url)
        if key:
            req.add_header("Authorization", f"Bearer {key}")
        try:
            with urllib.request.urlopen(req, timeout=5) as r:
                eprint(f"hermes: OK {url}\n{json.dumps(json.load(r), indent=2)}")
        except Exception as e:
            eprint(f"hermes: {bu}  ({type(e).__name__}: {e})")
        return
    if cmd == "harness":
        cfg, _ = load_cfg()
        require_armed("glm harness")
        task = args[1] if len(args) > 1 else None
        run_harness(cfg, task); return
    if cmd == "neutronstar":
        cfg, _ = load_cfg(); cmd_neutronstar(cfg, args); return
    if cmd in ("opencode", "hermes") or cmd.startswith("tiny-"):
        cfg, _ = load_cfg()
        role, sec, is_local = resolve_role(cfg, cmd)
        sub = args[1] if len(args) > 1 else None
        if is_local:
            if sub in (None, "serve"):
                require_armed(f"glm {cmd} serve")
                serve_local(role, sec, cfg)
            else:
                sys.exit(f"role {role} is local; use '{cmd} serve' (default) or no subcommand")
        else:
            if sub == "chat":
                if len(args) < 3:
                    sys.exit(f"usage: glm {cmd} chat \"your prompt\"")
                require_armed(f"glm {cmd} chat")
                proxy_chat(sec, " ".join(args[2:]))
            elif sub in (None, "status", "health"):
                bu = sec.get("base_url"); key = sec.get("api_key", "")
                url = bu.rstrip("/") + "/health"
                req = urllib.request.Request(url)
                if key:
                    req.add_header("Authorization", f"Bearer {key}")
                try:
                    with urllib.request.urlopen(req, timeout=5) as r:
                        eprint(f"{role}: OK {url}\n{json.dumps(json.load(r), indent=2)}")
                except Exception as e:
                    eprint(f"{role}: {bu}  ({type(e).__name__}: {e})")
            else:
                sys.exit(f"unknown subcommand for {role}: {sub}")
        return
    eprint(f"unknown command: {cmd}\n")
    eprint(__doc__)


if __name__ == "__main__":
    main()
