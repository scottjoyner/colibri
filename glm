#!/usr/bin/env python3
"""glm — front-door CLI for the local colibri fleet.

Routes by role to the right model/endpoint defined in configs/colibri.toml:

    glm opencode            # serve the GLM-5.2 primary (heavy hitter) locally
    glm hermes              # helper endpoint status
    glm hermes config       # emit the Hermes cli-config.yaml [model] block
    glm hermes check        # verify the hermes-adapter helper endpoint responds
    glm hermes chat "..."   # send a chat completion to the helper (remote)
    glm tiny-<name>         # future small harness (same pattern as hermes)
    glm harness [task]      # tier-3 orchestrator: fan subtasks out to subagents
    glm proxy               # local OpenAI-compatible router: GLM <-> helper by token budget
    glm route "<prompt>"    # dry-run: print which backend a request would hit
    glm health              # health of every configured endpoint
    glm ls                  # list configured roles
    glm neutronstar build   # build ds4 / ds4-server (HX 370 / Strix Halo)
    glm neutronstar serve   # launch ds4-server for a GGUF (machine-aware)
    glm neutronstar status  # check ds4-server health + advertised models
    glm neutronstar bench   # compare colibri primary vs ds4-server tok/s

Local roles (have a `model` path) are served via scripts/colibri-serve.
Remote roles (have a `base_url`, no `model`) are proxied/queried.

Config: configs/colibri.toml (override with $COLI_CONFIG).
This CLI does not modify any default configuration.
"""
import sys, os, json, subprocess, urllib.request, urllib.error, urllib.parse, tomllib
from http.server import BaseHTTPRequestHandler, HTTPServer
from concurrent.futures import ThreadPoolExecutor

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_CFG = os.path.join(HERE, "configs", "colibri.toml")


def load_cfg():
    path = os.environ.get("COLI_CONFIG", DEFAULT_CFG)
    if not os.path.exists(path):
        sys.exit(f"config not found: {path}")
    with open(path, "rb") as f:
        return tomllib.load(f), path


def eprint(*a):
    print(*a, file=sys.stderr)


# ── Fleet arming gate ───────────────────────────────────────────────────────
# The fleet's live actions (serve a 744B engine, run the proxy, fan out via the
# harness, send chat traffic, fine-tune) are DISARMED by default so nothing binds
# a port or launches a model until the operator explicitly arms it. Set
# COLI_LIVE=1 in the shell only when models/endpoints are verified ready.
def require_armed(action):
    if os.environ.get("COLI_LIVE") != "1":
        eprint(f"DISARMED: '{action}' is a live action and will not run.")
        eprint("  Arm the fleet only when models/endpoints are verified ready:")
        eprint("    export COLI_LIVE=1   # then re-run this command")
        sys.exit(2)


def _port_in_use(host, port, timeout=0.3):
    import socket
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except OSError:
        return False


def _endpoint_up(url, key="", timeout=4):
    req = urllib.request.Request(url)
    if key:
        req.add_header("Authorization", f"Bearer {key}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            ct = r.headers.get("Content-Type", "")
            return True, (json.load(r) if ct.startswith("application/json") else None)
    except Exception:
        return False, None


def _disk_free_gb(path):
    import shutil
    try:
        return shutil.disk_usage(path).free / (1 << 30)
    except Exception:
        return None


def cmd_doctor(cfg):
    """Pre-flight validator: read-only checks that the fleet is safe to arm.

    Reports PASS/WARN/FAIL for config completeness, port collisions/availability,
    local model paths, remote endpoint reachability, and per-subagent training
    prerequisites. No live actions are taken.
    """
    rows = []  # (level, area, detail)
    def add(level, area, detail=""):
        rows.append((level, area, detail))

    for sec in ("primary", "proxy", "helper", "hermes", "harness"):
        if cfg.get(sec):
            add("PASS", f"config[{sec}]", "present")
        else:
            add("WARN", f"config[{sec}]", "missing (some tiers disabled)")

    ports = {}
    def reg(port, who):
        if port is None:
            return
        ports.setdefault(int(port), []).append(who)
    reg(cfg.get("primary", {}).get("port", 8000), "primary")
    reg(cfg.get("proxy", {}).get("port", 8200), "proxy")
    for nm, s in (cfg.get("tiny", {}) or {}).items():
        reg(s.get("port", 8300), f"tiny.{nm}")
    for port, who in sorted(ports.items()):
        if len(who) > 1:
            add("FAIL", f"port {port}", f"collision: {', '.join(who)}")
        elif _port_in_use("127.0.0.1", port):
            add("WARN", f"port {port}", f"already in use ({who[0]})")
        else:
            add("PASS", f"port {port}", f"free ({who[0]})")

    prim = cfg.get("primary", {})
    if prim.get("model"):
        add("PASS" if os.path.exists(prim["model"]) else "FAIL",
            "primary.model", prim["model"])
    else:
        add("WARN", "primary.model", "no local model path (remote?)")

    for sec in ("helper", "hermes"):
        s = cfg.get(sec)
        if not s:
            continue
        bu = s.get("base_url") or s.get("adapter_base_url")
        if not bu:
            add("WARN", f"{sec}.base_url", "missing")
            continue
        up, _ = _endpoint_up(bu.rstrip("/") + "/health", s.get("api_key", ""))
        add("PASS" if up else "WARN", f"{sec}.endpoint",
            bu + (" reachable" if up else " NOT reachable (will fail at runtime)"))

    for nm, s in (cfg.get("tiny", {}) or {}).items():
        if s.get("model"):
            add("PASS" if os.path.exists(s["model"]) else "FAIL",
                f"tiny.{nm}.model", s["model"])
        tr = s.get("train_repo")
        if tr:
            ok = os.path.isdir(os.path.join(tr, "src"))
            add("PASS" if ok else "FAIL", f"tiny.{nm}.train_repo",
                tr + ("" if ok else " (no src/ — pipeline missing)"))
        tb = s.get("train_base") or s.get("model")
        if tb and not os.path.exists(tb):
            add("FAIL", f"tiny.{nm}.train_base", f"not found: {tb}")
        out = s.get("train_output")
        if out:
            parent = os.path.dirname(out) or "."
            add("PASS" if os.access(parent, os.W_OK) else "FAIL",
                f"tiny.{nm}.train_output", f"parent writable: {parent}")
            free = _disk_free_gb(parent)
            if free is not None and free < 20.0:
                add("WARN", f"tiny.{nm}.train_disk",
                    f"only {free:.1f} GB free at {parent} (checkpoints can be several GB)")
        src = s.get("train_source")
        if src not in (None, "opencode", "hermes"):
            add("FAIL", f"tiny.{nm}.train_source", f"invalid: {src}")

    # KV cache dir writability (engine creates <model>/.coli_kvdb at runtime)
    cache = cfg.get("cache", {})
    if cache.get("enabled", True) and prim.get("model"):
        mdir = os.path.dirname(prim["model"]) or "."
        kvdb = os.path.join(prim["model"], ".coli_kvdb")
        if os.access(mdir, os.W_OK):
            add("PASS", "kvdb.dir", f"writable: {kvdb}")
        else:
            add("WARN", "kvdb.dir", f"model dir not writable; cannot create {kvdb}")
        need = max(1.0, (float(cache.get("hot_gb", 0.5) or 0.5)) * 1.5)
        free = _disk_free_gb(mdir)
        if free is None:
            add("WARN", "disk[model]", f"cannot stat free space at {mdir}")
        elif free < need:
            add("WARN", "disk[model]", f"only {free:.1f} GB free at {mdir} (KV tier wants ~{need:.1f} GB)")
        else:
            add("PASS", "disk[model]", f"{free:.1f} GB free at {mdir}")

    # training deps per subagent (training runs on a CUDA/ROCm box, not here)
    for nm, s in (cfg.get("tiny", {}) or {}).items():
        if not s.get("train_repo"):
            continue
        import importlib.util as _iu
        have = lambda m: _iu.find_spec(m) is not None
        missing = [m for m in ("peft", "unsloth", "transformers", "datasets") if not have(m)]
        gpu = False
        try:
            import torch as _t
            gpu = _t.cuda.is_available() or "rocm" in str(getattr(_t.version, "__version__", "")).lower()
        except Exception:
            pass
        if missing or not gpu:
            add("WARN", f"tiny.{nm}.train_deps",
                f"missing={missing or 'none'}; torch GPU={gpu} (training must run on a CUDA/ROCm box)")
        else:
            add("PASS", f"tiny.{nm}.train_deps", "peft/unsloth/transformers/datasets + torch GPU present")

    order = {"PASS": 0, "WARN": 1, "FAIL": 2}
    rows.sort(key=lambda r: (order[r[0]], r[1]))
    fails = sum(1 for r in rows if r[0] == "FAIL")
    warns = sum(1 for r in rows if r[0] == "WARN")
    eprint("glm doctor — fleet pre-flight (read-only):")
    for lvl, area, detail in rows:
        eprint(f"  [{lvl}] {area}" + (f" — {detail}" if detail else ""))
    eprint("")
    eprint(f"doctor: {len(rows) - fails - warns} pass, {warns} warn, {fails} fail")
    if fails:
        eprint("  Resolve FAIL items before arming (export COLI_LIVE=1).")
    else:
        eprint("  No fatal issues. Fleet may be armed when ready (still DISARMED by default).")


def cmd_health_all(cfg):
    roles = []
    if "primary" in cfg:
        roles.append(("opencode (primary)", cfg["primary"].get("host", "127.0.0.1"),
                      int(cfg["primary"].get("port", 8000)),
                      cfg["primary"].get("api_key", "")))
    for name, sec in cfg.items():
        if name.startswith("helper") or name.startswith("tiny") or name == "hermes":
            bu = sec.get("base_url")
            if bu:
                from urllib.parse import urlparse
                u = urlparse(bu)
                roles.append((name, u.hostname or "127.0.0.1", u.port or 8000, sec.get("api_key", "")))
    for label, host, port, key in roles:
        url = f"http://{host}:{port}/health"
        try:
            req = urllib.request.Request(url)
            if key:
                req.add_header("Authorization", f"Bearer {key}")
            with urllib.request.urlopen(req, timeout=5) as r:
                data = json.load(r)
                hot = data.get("kv_cache_hot")
                extra = f" hot={hot['prompts']}prompts/{hot['size_mb']}MB hits={hot['hits']}" if hot else ""
                eprint(f"  OK   {label:24} {url}  rss={data.get('tiers',{}).get('ram_gb','?')}GB{extra}")
        except Exception as e:
            eprint(f"  DOWN {label:24} {url}  ({type(e).__name__}: {e})")


