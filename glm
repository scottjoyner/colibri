#!/usr/bin/env python3
"""glm — front-door CLI for the local colibri fleet.

Routes by role to the right model/endpoint defined in configs/colibri.toml:

    glm opencode            # serve the GLM-5.2 primary (heavy hitter) locally
    glm hermes              # helper endpoint status
    glm hermes config       # emit the Hermes cli-config.yaml [model] block
    glm hermes check        # verify the hermes-adapter helper endpoint responds
    glm hermes chat "..."   # send a chat completion to the helper (remote)
    glm tiny-<name>         # future small harness (same pattern as hermes)
    glm harness [task]      # tier-3 orchestrator: fan subtasks out to subagents
    glm proxy               # local OpenAI-compatible router: GLM <-> helper by token budget
    glm route "<prompt>"    # dry-run: print which backend a request would hit
    glm health              # health of every configured endpoint
    glm ls                  # list configured roles

Local roles (have a `model` path) are served via scripts/colibri-serve.
Remote roles (have a `base_url`, no `model`) are proxied/queried.

Config: configs/colibri.toml (override with $COLI_CONFIG).
This CLI does not modify any default configuration.
"""
import sys, os, json, subprocess, urllib.request, urllib.error, urllib.parse, tomllib
from http.server import BaseHTTPRequestHandler, HTTPServer
from concurrent.futures import ThreadPoolExecutor

HERE = os.path.dirname(os.path.abspath(__file__))
DEFAULT_CFG = os.path.join(HERE, "configs", "colibri.toml")


def load_cfg():
    path = os.environ.get("COLI_CONFIG", DEFAULT_CFG)
    if not os.path.exists(path):
        sys.exit(f"config not found: {path}")
    with open(path, "rb") as f:
        return tomllib.load(f), path


def eprint(*a):
    print(*a, file=sys.stderr)


def cmd_health_all(cfg):
    roles = []
    if "primary" in cfg:
        roles.append(("opencode (primary)", cfg["primary"].get("host", "127.0.0.1"),
                      int(cfg["primary"].get("port", 8000)),
                      cfg["primary"].get("api_key", "")))
    for name, sec in cfg.items():
        if name.startswith("helper") or name.startswith("tiny") or name == "hermes":
            bu = sec.get("base_url")
            if bu:
                from urllib.parse import urlparse
                u = urlparse(bu)
                roles.append((name, u.hostname or "127.0.0.1", u.port or 8000, sec.get("api_key", "")))
    for label, host, port, key in roles:
        url = f"http://{host}:{port}/health"
        try:
            req = urllib.request.Request(url)
            if key:
                req.add_header("Authorization", f"Bearer {key}")
            with urllib.request.urlopen(req, timeout=5) as r:
                data = json.load(r)
                hot = data.get("kv_cache_hot")
                extra = f" hot={hot['prompts']}prompts/{hot['size_mb']}MB hits={hot['hits']}" if hot else ""
                eprint(f"  OK   {label:24} {url}  rss={data.get('tiers',{}).get('ram_gb','?')}GB{extra}")
        except Exception as e:
            eprint(f"  DOWN {label:24} {url}  ({type(e).__name__}: {e})")


def cmd_ls(cfg):
    eprint("configured roles:")
    if "primary" in cfg:
        p = cfg["primary"]
        eprint(f"  opencode   local GLM-5.2  {p.get('host')}:{p.get('port')}  model={p.get('model_id')}")
    for name, sec in cfg.items():
        if name.startswith("helper") or name.startswith("tiny") or name == "hermes":
            if sec.get("base_url"):
                eprint(f"  {name:10} remote {sec.get('base_url')}  model={sec.get('model_id')}")
            elif sec.get("model"):
                eprint(f"  {name:10} local  {sec.get('model_id')}  {sec.get('host')}:{sec.get('port')}")


def serve_local(role, sec, cfg):
    """Launch a local serve role via scripts/colibri-serve, overriding the
    profile with this role's section when present."""
    script = os.path.join(HERE, "scripts", "colibri-serve")
    merged = dict(cfg.get("primary", {}))
    cache = dict(cfg.get("cache", {}))
    for k, v in sec.items():
        merged[k] = v
    import tempfile
    tmp = tempfile.NamedTemporaryFile("w", suffix=".toml", delete=False, dir=HERE)
    tmp.write('[primary]\n')
    for k, v in merged.items():
        if isinstance(v, bool):
            tmp.write(f'{k} = {"true" if v else "false"}\n')
        elif isinstance(v, str):
            tmp.write(f'{k} = "{v}"\n')
        else:
            tmp.write(f'{k} = {v}\n')
    tmp.write('[cache]\n')
    for k, v in cache.items():
        if isinstance(v, bool):
            tmp.write(f'{k} = {"true" if v else "false"}\n')
        elif isinstance(v, str):
            tmp.write(f'{k} = "{v}"\n')
        else:
            tmp.write(f'{k} = {v}\n')
    tmp.close()
    eprint(f"glm {role}: serving local model (pid parent)")
    os.execv(script, [script, tmp.name])


def proxy_chat(sec, prompt):
    bu = sec.get("base_url")
    if not bu:
        sys.exit("this role has no base_url (it is a local-serve role)")
    model = sec.get("model_id", "model")
    key = sec.get("api_key", "")
    url = bu.rstrip("/") + "/chat/completions"
    body = json.dumps({"model": model, "messages": [{"role": "user", "content": prompt}],
                       "temperature": 0, "max_tokens": 512}).encode()
    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
    if key:
        req.add_header("Authorization", f"Bearer {key}")
    try:
        with urllib.request.urlopen(req, timeout=120) as r:
            data = json.load(r)
            print(data["choices"][0]["message"]["content"])
    except urllib.error.HTTPError as e:
        sys.exit(f"chat failed: {e.code} {e.read().decode()[:500]}")


def chat_completion(base_url, api_key, model, messages, timeout=120):
    """Minimal OpenAI chat completion; returns the assistant text (no streaming)."""
    url = base_url.rstrip("/") + "/chat/completions"
    body = json.dumps({"model": model, "messages": messages, "temperature": 0,
                       "max_tokens": 1024}).encode()
    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json"})
    if api_key:
        req.add_header("Authorization", f"Bearer {api_key}")
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.load(r)["choices"][0]["message"]["content"]


def resolve_role(cfg, role):
    if role == "opencode":
        if "primary" not in cfg:
            sys.exit("no [primary] section in config")
        return "opencode", cfg["primary"], True
    if role == "hermes":
        sec = cfg.get("hermes") or cfg.get("helper")
        if not sec:
            sys.exit("no [helper] / [hermes] section in config")
        return "hermes", sec, "model" in sec
    if role.startswith("tiny-"):
        name = role[len("tiny-"):]
        sec = cfg.get(f"tiny.{name}")
        if not sec:
            sys.exit(f"no [tiny.{name}] section in config (tiny harness not built yet)")
        return role, sec, "model" in sec
    sys.exit(f"unknown role: {role}  (try: opencode, hermes, tiny-<name>)")


def estimate_tokens(body):
    """Rough token estimate to drive routing (no tokenizer dependency)."""
    msgs = body.get("messages", [])
    text = " ".join(m.get("content", "") for m in msgs if isinstance(m, dict))
    n = max(1, len(text) // 4)
    n += int(body.get("max_tokens", 0) or 0)
    return n


def pick_backend(cfg, body):
    proxy = cfg.get("proxy", {})
    thr = int(proxy.get("route_max_tokens", 256))
    est = estimate_tokens(body)
    helper = cfg.get("helper") or cfg.get("hermes")
    primary = cfg.get("primary", {})
    if helper and helper.get("base_url") and est <= thr:
        return ("helper", helper["base_url"], helper.get("api_key", ""),
                helper.get("model_id", "model"))
    pbase = f"http://{primary.get('host','127.0.0.1')}:{primary.get('port',8000)}/v1"
    return ("glm", pbase, primary.get("api_key", ""), primary.get("model_id", "model"))


def run_proxy(cfg):
    proxy = cfg.get("proxy", {})
    host = proxy.get("host", "127.0.0.1")
    port = int(proxy.get("port", 8200))
    rewrite = proxy.get("rewrite_model_id", True)
    thr = int(proxy.get("route_max_tokens", 256))

    class Handler(BaseHTTPRequestHandler):
        def _read_body(self):
            length = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(length) if length else b"{}"
            try:
                return json.loads(raw)
            except Exception:
                return {}

        def _forward(self, target_url, target_key, target_model):
            body = self._read_body()
            if rewrite and target_model:
                body["model"] = target_model
            fwd = json.dumps(body).encode()
            req = urllib.request.Request(target_url, data=fwd,
                                         headers={"Content-Type": "application/json"})
            if target_key:
                req.add_header("Authorization", f"Bearer {target_key}")
            try:
                r = urllib.request.urlopen(req, timeout=600)
            except urllib.error.HTTPError as e:
                self.send_response(e.code)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(e.read())
                return
            except (urllib.error.URLError, ConnectionError, OSError) as e:
                self.send_response(502)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"error": {"message": f"upstream unreachable: {e}",
                                                         "type": "upstream_unreachable"}}).encode())
                return
            self.send_response(r.status if hasattr(r, "status") else 200)
            ct = r.headers.get("Content-Type", "application/json")
            self.send_header("Content-Type", ct)
            self.send_header("Transfer-Encoding", "chunked")
            self.end_headers()
            while True:
                chunk = r.read(1 << 16)
                if not chunk:
                    break
                self.wfile.write(chunk)
                self.wfile.flush()

        def do_GET(self):
            if self.path.rstrip("/") in ("/health", "/v1/health"):
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(json.dumps({"status": "ok", "role": "proxy",
                                             "routes": {"glm": "primary", "helper": "helper"},
                                             "route_max_tokens": thr}).encode())
                return
            self.send_response(404); self.end_headers()

        def do_POST(self):
            if self.path.rstrip("/") in ("/v1/chat/completions", "/chat/completions"):
                body = self._read_body()
                label, bu, key, mid = pick_backend(cfg, body)
                eprint(f"[proxy] -> {label} ({bu})")
                self._forward(bu.rstrip("/") + "/chat/completions", key, mid)
                return
            self.send_response(404); self.end_headers()

        def log_message(self, *a):
            pass

    eprint(f"glm proxy: http://{host}:{port}/v1  (route <= {thr} tok -> helper, else GLM)")
    HTTPServer((host, port), Handler).serve_forever()


def cmd_route(cfg, prompt):
    body = {"messages": [{"role": "user", "content": prompt}], "max_tokens": 0}
    label, bu, key, mid = pick_backend(cfg, body)
    est = estimate_tokens(body)
    eprint(f"estimate={est} tok  ->  {label}  ({bu})  model={mid}")


def hermes_config(cfg):
    """Emit the Hermes cli-config.yaml [model] block so Hermes routes through
    the helper endpoint (OpenAI-compatible via provider:\"custom\")."""
    h = cfg.get("hermes", {})
    bu = h.get("adapter_base_url") or (cfg.get("helper", {}) or {}).get("base_url")
    key = h.get("adapter_api_key") or (cfg.get("helper", {}) or {}).get("api_key", "")
    model = h.get("helper") or (cfg.get("helper", {}) or {}).get("model_id", "model")
    if not bu:
        sys.exit("no hermes.adapter_base_url / helper.base_url in config")
    block = (
        "# generated by: glm hermes config  (drop into cli-config.yaml or ~/.hermes/cli-config.yaml)\n"
        "model:\n"
        f"  default: \"{model}\"\n"
        "  provider: \"custom\"\n"
        f"  base_url: \"{bu}\"\n"
        f"  api_key: \"{key}\"\n"
    )
    print(block)


def hermes_check(cfg):
    h = cfg.get("hermes", {}) or cfg.get("helper", {})
    bu = h.get("adapter_base_url") or h.get("base_url")
    key = h.get("adapter_api_key") or h.get("api_key", "")
    if not bu:
        sys.exit("no hermes/helper base_url in config")
    url = bu.rstrip("/") + "/health"
    req = urllib.request.Request(url)
    if key:
        req.add_header("Authorization", f"Bearer {key}")
    try:
        with urllib.request.urlopen(req, timeout=5) as r:
            data = json.load(r)
            eprint(f"hermes-adapter OK: {url}\n{json.dumps(data, indent=2)}")
    except Exception as e:
        eprint(f"hermes-adapter: {bu}  ({type(e).__name__}: {e})")


def run_harness(cfg, task):
    """Tier-3 orchestrator: a small LM plans subtasks, each is fanned out to a
    subagent (tiny.<name>) endpoint in parallel, results are collected and the
    orchestrator synthesizes a final answer.

    This is the skeleton: the orchestrator prompt + subtask parsing are TODO
    and should match whatever the harness-orchestrator model expects.
    """
    h = cfg.get("harness", {})
    if not h.get("enabled", True):
        sys.exit("harness disabled in config ([harness].enabled=false)")
    obu = h.get("base_url"); okey = h.get("api_key", ""); omodel = h.get("model_id", "model")
    subs = h.get("subagents", [])
    max_sub = int(h.get("max_subtasks", 8))
    if not task or task == "-":
        task = sys.stdin.read().strip()
    if not task:
        sys.exit("usage: glm harness \"<task>\"  (or pipe task via stdin)")

    eprint(f"[harness] task: {task[:80]}...")
    # 1) orchestrator plans subtasks as a JSON list of {"subagent":<name>,"task":<text>}
    plan_prompt = [
        {"role": "system", "content": "You are an orchestrator. Decompose the user task into "
         "independent subtasks. Reply ONLY with a JSON array: "
         "[{\"subagent\": <name>, \"task\": <text>}, ...]. Valid subagent names: "
         + ", ".join(subs) + ". If the task is atomic, return a single-element array."},
        {"role": "user", "content": task},
    ]
    try:
        plan_text = chat_completion(obu, okey, omodel, plan_prompt)
    except Exception as e:
        sys.exit(f"[harness] orchestrator unreachable: {e}")
    # 2) parse the plan (best-effort: extract the first JSON array)
    import re
    m = re.search(r"\[.*\]", plan_text, re.DOTALL)
    try:
        plan = json.loads(m.group(0)) if m else [{"subagent": subs[0] if subs else "example", "task": task}]
    except Exception:
        plan = [{"subagent": subs[0] if subs else "example", "task": task}]
    plan = plan[:max_sub]
    eprint(f"[harness] plan: {len(plan)} subtask(s)")

    # 3) fan out each subtask to its subagent (tiny.<name>) endpoint in parallel
    def run_sub(sub):
        name = sub.get("subagent", subs[0] if subs else "example")
        stext = sub.get("task", task)
        sec = cfg.get(f"tiny.{name}")
        if not sec or not sec.get("base_url"):
            return name, f"[no [tiny.{name}] endpoint configured]"
        try:
            res = chat_completion(sec["base_url"], sec.get("api_key", ""),
                                   sec.get("model_id", name),
                                   [{"role": "user", "content": stext}])
            return name, res
        except Exception as e:
            return name, f"[subagent {name} error: {e}]"

    with ThreadPoolExecutor(max_workers=max_sub) as ex:
        results = list(ex.map(run_sub, plan))

    # 4) orchestrator synthesizes the final answer from the subtask results
    synth_msgs = [{"role": "system", "content": "Synthesize a final answer from the subtask "
                  "results below."},
                  {"role": "user", "content": "\n\n".join(f"[{n}]\n{r}" for n, r in results)}]
    try:
        final = chat_completion(obu, okey, omodel, synth_msgs)
    except Exception as e:
        final = "\n\n".join(f"[{n}]\n{r}" for n, r in results)  # fallback: raw concat
    print(final)


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        eprint(__doc__)
        return
    cmd = args[0]
    if cmd in ("ls", "list"):
        cfg, _ = load_cfg(); cmd_ls(cfg); return
    if cmd == "health":
        cfg, _ = load_cfg(); cmd_health_all(cfg); return
    if cmd == "route":
        cfg, _ = load_cfg()
        if len(args) < 2:
            sys.exit("usage: glm route \"your prompt\"")
        cmd_route(cfg, " ".join(args[1:])); return
    if cmd == "proxy":
        cfg, _ = load_cfg()
        if not cfg.get("proxy", {}).get("enabled", True):
            sys.exit("proxy disabled in config ([proxy].enabled=false)")
        run_proxy(cfg); return
    if cmd == "hermes":
        cfg, _ = load_cfg()
        sub = args[1] if len(args) > 1 else None
        if sub == "config":
            hermes_config(cfg); return
        if sub == "check":
            hermes_check(cfg); return
        # default: status; or chat
        if sub == "chat":
            if len(args) < 3:
                sys.exit("usage: glm hermes chat \"your prompt\"")
            _, sec, _ = resolve_role(cfg, "hermes")
            proxy_chat(sec, " ".join(args[2:])); return
        _, sec, is_local = resolve_role(cfg, "hermes")
        if is_local:
            sys.exit("hermes role is remote; use 'glm hermes config|check|chat'")
        bu = sec.get("base_url"); key = sec.get("api_key", "")
        url = bu.rstrip("/") + "/health"
        req = urllib.request.Request(url)
        if key:
            req.add_header("Authorization", f"Bearer {key}")
        try:
            with urllib.request.urlopen(req, timeout=5) as r:
                eprint(f"hermes: OK {url}\n{json.dumps(json.load(r), indent=2)}")
        except Exception as e:
            eprint(f"hermes: {bu}  ({type(e).__name__}: {e})")
        return
    if cmd == "harness":
        cfg, _ = load_cfg()
        task = args[1] if len(args) > 1 else None
        run_harness(cfg, task); return
    if cmd in ("opencode", "hermes") or cmd.startswith("tiny-"):
        cfg, _ = load_cfg()
        role, sec, is_local = resolve_role(cfg, cmd)
        sub = args[1] if len(args) > 1 else None
        if is_local:
            if sub in (None, "serve"):
                serve_local(role, sec, cfg)
            else:
                sys.exit(f"role {role} is local; use '{cmd} serve' (default) or no subcommand")
        else:
            if sub == "chat":
                if len(args) < 3:
                    sys.exit(f"usage: glm {cmd} chat \"your prompt\"")
                proxy_chat(sec, " ".join(args[2:]))
            elif sub in (None, "status", "health"):
                bu = sec.get("base_url"); key = sec.get("api_key", "")
                url = bu.rstrip("/") + "/health"
                req = urllib.request.Request(url)
                if key:
                    req.add_header("Authorization", f"Bearer {key}")
                try:
                    with urllib.request.urlopen(req, timeout=5) as r:
                        eprint(f"{role}: OK {url}\n{json.dumps(json.load(r), indent=2)}")
                except Exception as e:
                    eprint(f"{role}: {bu}  ({type(e).__name__}: {e})")
            else:
                sys.exit(f"unknown subcommand for {role}: {sub}")
        return
    eprint(f"unknown command: {cmd}\n")
    eprint(__doc__)


if __name__ == "__main__":
    main()
